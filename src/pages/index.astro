---
import { getCollection } from 'astro:content';
import MainLayout from '../layouts/MainLayout.astro';
import Hero from '../components/sections/Hero.astro';
import Projects from '../components/sections/Projects.astro';
import Skills from '../components/sections/Skills.astro';
import Education from '../components/sections/Education.astro';
import Contact from '../components/sections/Contact.astro';
const homeProjects = (await getCollection('projects')).filter(p => p.data.featured).sort((a,b) => b.data.date.getTime()-a.data.date.getTime());
---
<MainLayout title="Archit Dewan | Software Developer" description="Computer Science and Mathematics student at McMaster University building backend systems, developer tools, and open-source software.">
<main class="content-shell">
<Hero />
<section id="about" class="section-block about"><h2 class="numbered-heading"><span>01.</span> A little about me</h2><div class="about-grid"><div><p>I'm Archit, a Computer Science and Mathematics student at McMaster University. My projects focus on the systems behind the interface: APIs, databases, automation, and the tools that help developers work.</p><p>I work primarily with Go, Python, and PostgreSQL. Recently, I've been building incident-response workflows, monitoring API reliability, and contributing to Traefik's Kubernetes ingress provider.</p><p>I also like taking software beyond the screen. At Hack the North, I helped build Surge Prep, a surgical-training prototype combining computer vision, physical tools, and a Unity simulation.</p></div><Education /></div><Skills /></section>
<section id="experience" class="section-block"><h2 class="numbered-heading"><span>02.</span> Open source</h2><div class="experience-grid"><div class="experience-label mono">Traefik</div><div><h3>Open Source Contributor <span class="accent">@ Traefik</span></h3><p class="mono muted">Kubernetes · Go · Ingress</p><ul class="contributions"><li>Implemented adaptive sticky-session cookie handling across three load-balancing strategies, with compatibility tests for legacy browsers.</li><li>Fixed ingress-nginx path matching for the NGINX prefix modifier, added regression tests, and documented supported behavior.</li></ul><a class="text-link" href="https://github.com/traefik/traefik/pulls?q=is%3Apr+author%3AArchitDewan" target="_blank" rel="noreferrer">View contributions ↗</a></div></div></section>
<Projects projects={homeProjects} /><Contact />
</main></MainLayout>
