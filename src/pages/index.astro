---
import { getCollection } from 'astro:content';
import MainLayout from '../layouts/MainLayout.astro';
import Hero from '../components/sections/Hero.astro';
import Experience from '../components/sections/Experience.astro';
import Projects from '../components/sections/Projects.astro';
import Skills from '../components/sections/Skills.astro';
import Contact from '../components/sections/Contact.astro';
const portrait = '/portrait-960.webp';
const homeProjects = (await getCollection('projects')).filter(p => p.data.featured).sort((a,b) => b.data.date.getTime()-a.data.date.getTime());
---
<MainLayout title="Archit Dewan | Software Developer" description="Computer Science and Mathematics student at McMaster University building backend systems, developer tools, and open-source software.">
<main class="content-shell">
<Hero />
<section id="about" class="section-block about">
  <h2 class="numbered-heading">About Me</h2>
  <div class:list={["about-grid", { "without-portrait": !portrait }]}>
    <div class="about-copy">
      <p>Hi there!</p>
      <p>I'm Archit Dewan, a Computer Science and Mathematics student at <a class="text-link" href="https://www.mcmaster.ca/">McMaster University</a>. I enjoy building backend systems, developer tools, and software that makes complex workflows easier to manage.</p>
      <p>I'm also involved in machine learning research through the Cohere Labs Open Science Community. Recently, I've been contributing to open-source projects including <a class="text-link" href="https://github.com/traefik/traefik/pulls?q=is%3Apr+author%3AArchitDewan" target="_blank" rel="noreferrer">Traefik</a> and <a class="text-link" href="https://github.com/boykopovar/AnyPS5/pull/2395" target="_blank" rel="noreferrer">AnyPS5</a>, improving ingress behavior and audio decoding reliability. My projects span API reliability, incident response, and automation, primarily using Go, Python, and PostgreSQL.</p>
      <p>I also like taking software beyond the screen. At Hack the North, I helped build <a class="text-link" href="https://github.com/mtorregrosadev/HTN-Surgery">Surge Prep</a>, a surgical-training prototype combining computer vision, a physical tool, and a Unity simulation.</p>
      <Skills />
    </div>
    {portrait && <div class="about-aside"><figure class="portrait-frame"><img src={portrait} alt="Archit Dewan" srcset="/portrait-480.webp 480w, /portrait-960.webp 960w" sizes="(max-width: 760px) 380px, 445px" width="960" height="1280" loading="eager" decoding="async" /></figure></div>}
  </div>
</section>
<Experience />
<section id="open-source" class="section-block"><h2 class="numbered-heading">Open source</h2><div class="experience-grid"><div class="experience-label mono">Traefik</div><div><h3>Open Source Contributor <span class="accent">@ Traefik</span></h3><p class="mono muted">Kubernetes · Go · Ingress</p><ul class="contributions"><li>Implemented adaptive sticky-session cookie handling across three load-balancing strategies, with compatibility tests for legacy browsers.</li><li>Fixed ingress-nginx path matching for the NGINX prefix modifier, added regression tests, and documented supported behavior.</li></ul><a class="text-link" href="https://github.com/traefik/traefik/pulls?q=is%3Apr+author%3AArchitDewan" target="_blank" rel="noreferrer">View contributions ↗</a></div></div><div class="experience-grid"><div class="experience-label mono">AnyPS5</div><div><h3>Open Source Contributor <span class="accent">@ AnyPS5</span></h3><p class="mono muted">C · CMake · Audio Decoding</p><ul class="contributions"><li>Fixed ATRAC9 audio decoder gradient bounds validation, rejecting invalid end-unit values to prevent out-of-range processing.</li><li>Integrated the fix through a build-time LibAtrac9 patch and added regression tests covering valid and invalid gradient boundaries.</li></ul><a class="text-link" href="https://github.com/boykopovar/AnyPS5/pull/2395" target="_blank" rel="noreferrer">View merged PR #2395 ↗</a></div></div></section>
<Projects projects={homeProjects} /><Contact />
</main></MainLayout>
