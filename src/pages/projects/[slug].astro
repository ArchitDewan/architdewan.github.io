---
import { getCollection, render } from 'astro:content';
import MainLayout from '../../layouts/MainLayout.astro';
import ProjectVisual from '../../components/project/ProjectVisual.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}

const { project } = Astro.props;
const { Content } = await render(project);
---

<MainLayout title={`${project.data.title} | Archit Dewan`} description={project.data.summary}>
  <main class="content-shell case-study">
    <a class="back-link mono" href="/projects">← project archive</a>
    <header class="case-header reveal is-visible">
      <div>
        <p class="section-kicker">case study / {project.slug}</p>
        <h1>{project.data.title}</h1>
        <p class="summary">{project.data.summary}</p>
        <div class="case-tags">{project.data.stack.map((item) => <span class="tag">{item}</span>)}</div>
        <div class="case-actions"><a class="button button-primary" href={project.data.repoUrl} target="_blank" rel="noreferrer">Open repository ↗</a>{project.data.liveUrl && <a class="button" href={project.data.liveUrl} target="_blank" rel="noreferrer">Live demo ↗</a>}</div>
      </div>
      <div class="panel visual-panel"><div class="panel-header"><span class="panel-tab">system.preview</span><span>{project.data.date.getFullYear()}</span></div><ProjectVisual variant={project.data.visualVariant} /></div>
    </header>

    <section class="case-facts reveal" aria-label="Project summary">
      <article><span class="mono">01</span><h2>Problem</h2><p>{project.data.problem}</p></article>
      <article><span class="mono">02</span><h2>Approach</h2><p>{project.data.approach}</p></article>
      <article><span class="mono">03</span><h2>Outcome</h2><p>{project.data.outcome}</p></article>
    </section>

    <article class="case-content panel reveal">
      <div class="panel-header"><span class="panel-tab">README.md</span><span>project notes</span></div>
      <div class="prose"><Content /></div>
    </article>
  </main>
</MainLayout>

<style>
  .case-study{padding-block:36px 90px}.back-link{display:inline-flex;margin-bottom:38px;color:var(--cyan);font-size:11px}.back-link:hover{color:var(--ink)}
  .case-header{display:grid;grid-template-columns:1fr minmax(360px,.82fr);gap:clamp(36px,7vw,80px);align-items:center}h1{margin:16px 0 0;font:600 clamp(48px,7vw,82px)/.92 'Space Grotesk',sans-serif;letter-spacing:-.055em}.summary{max-width:650px;margin:24px 0 0;color:var(--ink-muted);font-size:17px;line-height:1.75}.case-tags,.case-actions{display:flex;flex-wrap:wrap;gap:8px;margin-top:22px}.case-actions{margin-top:28px}.visual-panel{box-shadow:var(--shadow)}
  .case-facts{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;margin-top:80px;border:1px solid var(--line);border-radius:10px;overflow:hidden;background:var(--line)}.case-facts article{padding:28px;background:var(--surface)}.case-facts span{color:var(--cyan);font-size:9px}.case-facts h2{margin:15px 0 0;font:600 22px 'Space Grotesk',sans-serif}.case-facts p{margin:12px 0 0;color:var(--ink-muted);font-size:13px;line-height:1.75}
  .case-content{margin-top:28px}.prose{padding:clamp(26px,5vw,54px)}.prose :global(h2){margin:0 0 18px;font:600 30px 'Space Grotesk',sans-serif}.prose :global(p){max-width:760px;color:var(--ink-muted);line-height:1.8}.prose :global(a){color:var(--cyan);text-decoration:underline;text-underline-offset:3px}
  @media(max-width:900px){.case-header{grid-template-columns:1fr}.case-facts{grid-template-columns:1fr}.case-facts article+article{border-top:1px solid var(--line)}}
</style>
