---
import type { CollectionEntry } from 'astro:content';
import ProjectVisual from './ProjectVisual.astro';

interface Props { project: CollectionEntry<'projects'>; index?: number; }
const { project, index = 0 } = Astro.props;
const { data, slug } = project;
const primaryHref = data.caseStudy ? `/projects/${slug}/` : data.repoUrl;
---

<article class="project-card panel reveal" data-project-card data-stack={data.stack.join(' ').toLowerCase()} style={`--delay:${index * 70}ms`}>
  <ProjectVisual variant={data.visualVariant} />
  <div class="project-body">
    <div class="project-meta mono"><span>0{index + 1}</span><span>{data.role}</span></div>
    <h3><a href={primaryHref} target={!data.caseStudy ? '_blank' : undefined} rel={!data.caseStudy ? 'noreferrer' : undefined}>{data.title}</a></h3>
    <p>{data.summary}</p>
    <div class="project-tags">{data.stack.slice(0, 5).map((item) => <span class="tag">{item}</span>)}</div>
    <div class="project-links mono">
      {data.caseStudy && <a href={`/projects/${slug}/`}>case study <span>↗</span></a>}
      <a href={data.repoUrl} target="_blank" rel="noreferrer">repository <span>↗</span></a>
      {data.liveUrl && <a href={data.liveUrl} target="_blank" rel="noreferrer">live demo <span>↗</span></a>}
    </div>
  </div>
</article>

<style>
  .project-card { transition: border-color 180ms ease, transform 180ms ease, box-shadow 180ms ease, opacity 600ms cubic-bezier(.22,1,.36,1) var(--delay), transform 600ms cubic-bezier(.22,1,.36,1) var(--delay); }
  .project-card:hover { border-color: var(--line-strong); transform: translateY(-4px); box-shadow: 0 26px 70px rgba(0,0,0,.34); }
  .project-body { padding: 22px; }
  .project-meta { display:flex; justify-content:space-between; color:var(--cyan); font-size:9px; letter-spacing:.1em; text-transform:uppercase; }
  h3 { margin:14px 0 0; font:600 clamp(23px,3vw,30px)/1.1 'Space Grotesk',sans-serif; letter-spacing:-.025em; }
  h3 a:hover { color:var(--cyan); }
  p { min-height:68px; margin:12px 0 0; color:var(--ink-muted); font-size:13px; line-height:1.7; }
  .project-tags { display:flex; flex-wrap:wrap; gap:7px; margin-top:18px; }
  .project-links { display:flex; flex-wrap:wrap; gap:16px; margin-top:22px; border-top:1px solid var(--line); padding-top:16px; font-size:10px; }
  .project-links a { color:var(--ink-soft); }
  .project-links a:hover { color:var(--cyan); }
  .project-links span { color:var(--cyan); }
</style>
