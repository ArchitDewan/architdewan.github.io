---
import type { CollectionEntry } from 'astro:content';
import ProjectVisual from './ProjectVisual.astro';

interface Props { project: CollectionEntry<'projects'>; index?: number; }
const { project, index = 0 } = Astro.props;
const { data } = project;
const primaryHref = data.liveUrl ?? data.repoUrl;
---

<article class="project-card reveal" data-project-card data-stack={data.stack.join(' ').toLowerCase()} style={`--delay:${index * 70}ms`}>
  <a class:list={['project-preview', { 'has-cover': data.coverImage }]} href={primaryHref} target="_blank" rel="noreferrer" aria-label={`View ${data.title}`}>
    {data.coverImage ? <img src={data.coverImage} alt={`${data.title} project screenshot`} loading="lazy" width="1200" height="900" /> : <ProjectVisual variant={data.visualVariant} />}
  </a>
  <div class="project-body">
    <div class="project-meta mono"><span>Project</span><span>{data.date.getFullYear()}</span></div>
    <h3><a href={primaryHref} target="_blank" rel="noreferrer">{data.title}</a></h3>
    <p>{data.summary}</p>
    <div class="project-tags">{data.stack.slice(0, 5).map((item) => <span class="tag">{item}</span>)}</div>
    <div class="project-links mono">
      <a href={data.repoUrl} target="_blank" rel="noreferrer">repository <span>↗</span></a>
      {data.liveUrl && <a href={data.liveUrl} target="_blank" rel="noreferrer">live demo <span>↗</span></a>}
    </div>
  </div>
</article>

