---
import type { CollectionEntry } from 'astro:content';
import ProjectCard from '../project/ProjectCard.astro';

interface Props { projects: CollectionEntry<'projects'>[]; }
const { projects } = Astro.props;
---

<section id="projects" class="section-block">
  <div class="projects-heading reveal">
    <div><p class="section-kicker">01 / projects</p><h2 class="section-title">Featured Projects</h2></div>
    <a class="archive-link mono" href="/projects">open project archive <span>→</span></a>
  </div>
  <div class="project-grid">{projects.map((project, index) => <ProjectCard project={project} index={index} />)}</div>
</section>

<style>
  .projects-heading { display:flex; justify-content:space-between; gap:40px; align-items:end; }
  .archive-link { display:inline-flex; gap:8px; margin-top:18px; color:var(--cyan); font-size:11px; }
  .archive-link:hover { color:var(--ink); }
  .project-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:22px; margin-top:44px; }
  @media(max-width:820px){.projects-heading{align-items:start;flex-direction:column;gap:20px}.project-grid{grid-template-columns:1fr}}
</style>
