<section id="contact" class="section-block reveal">
  <div class="contact-panel panel">
    <div class="panel-header"><span class="panel-tab">contact.request</span></div>
    <div class="contact-body">
      <div>
        <p class="section-kicker">04 / contact</p>
        <h2 class="section-title">Contact</h2>
      </div>
      <div class="contact-links mono">
        <button type="button" data-copy-email>
          <span class="contact-identity">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 5H4a2 2 0 0 0-2 2v10c0 1.1.9 2 2 2h16a2 2 0 0 0 2-2V7c0-1.1-.9-2-2-2Zm0 2-8 5L4 7h16Zm0 10H4V9.2l8 5 8-5V17Z" /></svg>
            <span class="contact-copy"><small>email</small>architdewan2006@gmail.com</span>
          </span>
          <b data-copy-label>copy ↗</b>
        </button>
        <a href="https://github.com/ArchitDewan" target="_blank" rel="noreferrer">
          <span class="contact-identity">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 .5a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2.1c-3.3.7-4-1.6-4-1.6a3.1 3.1 0 0 0-1.3-1.7c-1.1-.8.1-.8.1-.8a2.5 2.5 0 0 1 1.8 1.2 2.6 2.6 0 0 0 3.5 1 2.7 2.7 0 0 1 .8-1.7c-2.7-.3-5.5-1.3-5.5-6A4.7 4.7 0 0 1 5.5 8a4.4 4.4 0 0 1 .1-3.2s1-.3 3.3 1.2a11.5 11.5 0 0 1 6 0c2.3-1.5 3.3-1.2 3.3-1.2a4.4 4.4 0 0 1 .1 3.2 4.7 4.7 0 0 1 1.2 3.2c0 4.8-2.8 5.7-5.5 6a3 3 0 0 1 .9 2.3v3.4c0 .3.2.7.8.6A12 12 0 0 0 12 .5Z" /></svg>
            <span class="contact-copy"><small>github</small>@ArchitDewan</span>
          </span>
          <b>open ↗</b>
        </a>
        <a href="https://www.linkedin.com/in/architdewan/" target="_blank" rel="noreferrer">
          <span class="contact-identity">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.4 20.5h-3.6v-5.7c0-1.4 0-3.1-1.9-3.1s-2.2 1.5-2.2 3v5.8H9.1V9h3.4v1.6h.1c.5-.9 1.7-1.9 3.5-1.9 3.8 0 4.5 2.5 4.5 5.7v6.1ZM5 7.5a2.1 2.1 0 1 1 0-4.2 2.1 2.1 0 0 1 0 4.2ZM6.8 20.5H3.2V9h3.6v11.5Z" /></svg>
            <span class="contact-copy"><small>linkedin</small>architdewan</span>
          </span>
          <b>open ↗</b>
        </a>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  document.querySelector('[data-copy-email]')?.addEventListener('click', async (event) => {
    const label = event.currentTarget.querySelector('[data-copy-label]');
    try { await navigator.clipboard.writeText('architdewan2006@gmail.com'); if (label) label.textContent = 'copied ✓'; }
    catch { window.location.href = 'mailto:architdewan2006@gmail.com'; }
    setTimeout(() => { if (label) label.textContent = 'copy ↗'; }, 1800);
  });
</script>

<style>
  .contact-panel{border-color:var(--line-strong)}.contact-body{display:grid;grid-template-columns:1.1fr .9fr;gap:clamp(40px,8vw,90px);padding:clamp(26px,5vw,56px)}
  .section-title{max-width:620px}.contact-links{display:grid;gap:10px}.contact-links a,.contact-links button{display:flex;width:100%;align-items:center;justify-content:space-between;gap:16px;border:1px solid var(--line);border-radius:6px;padding:13px 14px;color:var(--ink-soft);background:var(--bg-deep);text-align:left;cursor:pointer;transition:border-color 160ms ease,transform 160ms ease}
  .contact-links a:hover,.contact-links button:hover{border-color:var(--cyan);transform:translateX(3px)}.contact-identity{display:flex;min-width:0;align-items:center;gap:12px}.contact-identity>svg{width:20px;height:20px;flex:none;fill:currentColor;color:var(--ink-soft)}.contact-copy{min-width:0;overflow:hidden;font-size:10px;text-overflow:ellipsis}.contact-links small{display:block;margin-bottom:3px;color:var(--ink-muted);font-size:8px}.contact-links b{flex:none;color:var(--cyan);font-size:9px;font-weight:500}
  @media(max-width:800px){.contact-body{grid-template-columns:1fr}}
</style>
