---
const groups = [
  { title: 'Languages', index: '01', skills: ['Go', 'Python', 'Java', 'SQL', 'HTML/CSS', 'Bash'] },
  { title: 'Databases', index: '02', skills: ['PostgreSQL', 'SQLAlchemy'] },
  { title: 'Developer Tools', index: '03', skills: ['Git', 'GitHub', 'VS Code', 'Cursor', 'Codex', 'Docker', 'Postman', 'DataGrip'] },
  { title: 'Cloud and Systems', index: '04', skills: ['Unix/Linux', 'Oracle Cloud', 'REST APIs', 'Webhooks', 'CI/CD'] }
];
---

<section id="skills" class="section-block reveal">
  <p class="section-kicker">02 / skills</p>
  <h2 class="section-title">Technical Skills</h2>
  <div class="skills-grid">
    {groups.map((group) => (
      <article class="skill-group panel">
        <div class="panel-header"><span class="panel-tab">{group.title}</span><span>{group.index}</span></div>
        <ul>{group.skills.map((skill) => <li><span aria-hidden="true">›</span>{skill}</li>)}</ul>
      </article>
    ))}
  </div>
</section>

<style>
  .skills-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px;margin-top:40px}.skill-group{box-shadow:none}
  ul{display:grid;gap:11px;margin:0;padding:20px;list-style:none}li{display:flex;gap:9px;color:var(--ink-muted);font-size:12px}li span{color:var(--cyan);font-family:'JetBrains Mono',monospace}
  @media(max-width:960px){.skills-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:600px){.skills-grid{grid-template-columns:1fr}}
</style>
